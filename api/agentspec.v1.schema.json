{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dark-factory.dev/schemas/agentspec.v1.json",
  "title": "Agent Spec (agents/v1)",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "const": "agents/v1" },
    "kind": { "const": "Agent" },
    "metadata": {
      "type": "object",
      "required": ["name", "owner"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "required": ["model", "prompt", "triggers", "limits"],
      "properties": {
        "model": {
          "type": "object",
          "required": ["provider", "name"],
          "properties": {
            "provider": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "params": { "type": "object" }
          }
        },
        "prompt": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["inline", "template-ref"] },
            "value": { "type": "string" }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "scopes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
              "requiresApproval": { "type": "boolean" }
            }
          }
        },
        "mcpServers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ref", "version"],
            "properties": {
              "ref": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "auth": { "enum": ["oauth-user"] },
              "allowedTools": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "environment": { "$ref": "#/$defs/environment" },
        "memory": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["conversation", "vector-store"] },
            "retention": { "type": "string", "pattern": "^[0-9]+d$" }
          }
        },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": { "enum": ["chat", "schedule", "webhook"] },
              "cron": { "type": "string", "pattern": "^\\S+\\s+\\S+\\s+\\S+\\s+\\S+\\s+\\S+$" }
            }
          }
        },
        "limits": {
          "type": "object",
          "required": ["maxStepsPerRun", "maxTokensPerRun", "monthlyBudgetUsd"],
          "properties": {
            "maxStepsPerRun": { "type": "integer", "exclusiveMinimum": 0 },
            "maxTokensPerRun": { "type": "integer", "exclusiveMinimum": 0 },
            "monthlyBudgetUsd": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "required": ["image"],
      "properties": {
        "image": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["docker-ref", "dockerfile"] },
            "ref": { "type": "string" },
            "dockerfile": { "type": "string" }
          }
        },
        "setup": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["run"],
            "properties": { "run": { "type": "string", "minLength": 1 } }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "cpu": { "type": "string" },
            "memory": { "type": "string" },
            "disk": { "type": "string" }
          }
        },
        "repos": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url", "ref", "path"],
            "properties": {
              "url": { "type": "string", "pattern": "^https://" },
              "ref": { "type": "string", "minLength": 1 },
              "clonePolicy": { "enum": ["env-build", "session-start"] },
              "path": { "type": "string", "pattern": "^/" },
              "auth": { "type": "string" }
            }
          }
        },
        "network": { "type": "string" }
      }
    }
  }
}
