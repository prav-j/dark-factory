# Sandbox harness image: runs INSIDE session pods as the agent runtime.
FROM golang:1.20-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY api/ ./api/
COPY internal/ ./internal/
COPY cmd/harness ./cmd/harness
COPY cmd/git-credential-darkfactory ./cmd/git-credential-darkfactory
RUN CGO_ENABLED=0 go build -o /out/harness ./cmd/harness && \
    CGO_ENABLED=0 go build -o /out/git-credential-darkfactory ./cmd/git-credential-darkfactory

FROM alpine:3.19
RUN apk add --no-cache git ca-certificates && \
    adduser -D -u 10001 dev
COPY --from=build /out/harness /usr/local/bin/harness
COPY --from=build /out/git-credential-darkfactory /usr/local/bin/git-credential-darkfactory
USER dev
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/harness"]
